{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Resonance",
  "version": "0.1.0",
  "identifier": "com.danyalrez.resonance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonance",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "backgroundColor": "#07070b",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
